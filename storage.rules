rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Blog images (and their generated thumbnails) are publicly readable —
    // admin.js constructs download URLs without a token, relying on this.
    match /post-images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
