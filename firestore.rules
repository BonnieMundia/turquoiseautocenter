rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Blog posts are publicly readable. Writes are restricted to the
    // signed-in admin (admin.html) — the only Firebase Auth user.
    match /posts/{postId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Enquiries are created only by the submitEnquiry Cloud Function
    // (Admin SDK bypasses these rules). The admin panel can read/update
    // status once signed in; nothing else reads or writes this collection.
    match /enquiries/{enquiryId} {
      allow read, update: if request.auth != null;
      allow create, delete: if false;
    }
  }
}
